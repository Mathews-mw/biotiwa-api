// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AccountProvider {
  CREDENTIALS
  GOOGLE
}

enum MarketCode {
  BR
  US
}

enum ConsentType {
  TERMS_OF_USE
  PRIVACY_POLICY
  MARKETING
}

model User {
  id            String    @id @unique @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  customerProfile CustomerProfile?
  addresses       Address[]
  consents        UserConsent[]
  accounts        Account[]
  sessions        Session[]

  @@map("users")
}

model Account {
  id                    String          @id @default(cuid())
  userId                String          @map("user_id")
  accountId             String          @map("account_id") // BetterAuth: The ID of the account as provided by the SSO or equal to userId for credential accounts
  providerId            String          @map("provider_id")
  provider              AccountProvider
  accessToken           String?         @map("access_token")
  refreshToken          String?         @map("refresh_token")
  accessTokenExpiresAt  DateTime?       @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime?       @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?         @map("id_token")
  password              String?
  isActive              Boolean         @default(true) @map("is_active")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime?       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model CustomerProfile {
  id              String      @id @default(cuid())
  userId          String      @unique @map("user_id")
  preferredMarket MarketCode? @map("preferred_market")
  phone           String?
  birthDate       DateTime?   @map("birth_date")
  document        String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime?   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model Address {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  market       MarketCode
  label        String?
  recipient    String?
  postalCode   String     @map("postal_code")
  addressLine1 String     @map("address_line_1")
  number       String?
  addressLine2 String?    @map("address_line_2")
  district     String?
  city         String
  state        String
  country      String
  isDefault    Boolean    @default(false) @map("is_default")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime?  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([market])
  @@index([userId, isDefault])
  @@map("address")
}

model UserConsent {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  termId     String   @map("term_id")
  acceptedAt DateTime @map("accepted_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  terms ConsentTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([userId, termId])
  @@index([userId])
  @@map("user_consent")
}

model ConsentTerm {
  id          String      @id @default(cuid())
  type        ConsentType
  version     String
  title       String
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime?   @updatedAt @map("updated_at")

  userConsents UserConsent[]

  @@unique([type, version])
  @@index([type])
  @@map("consent_terms")
}
