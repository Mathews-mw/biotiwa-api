generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AccountProvider {
  CREDENTIALS
  GOOGLE
}

enum ConsentType {
  TERMS_OF_USE
  PRIVACY_POLICY
  MARKETING
}

enum MarketCode {
  BR
  US
}

enum CurrencyCode {
  BRL
  USD
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum CartItemType {
  OFFER
  PRODUCT
  ORDER_BUMP
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
  PAYMENT_FAILED
  EXPIRED
}

enum OrderItemType {
  OFFER_ITEM
  PRODUCT
  ORDER_BUMP
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  EXPIRED
  REFUNDED
}

enum StripeWebhookEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model User {
  id            String    @id @unique @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  customerProfile CustomerProfile?
  addresses       Address[]
  consents        UserConsent[]
  accounts        Account[]
  sessions        Session[]
  carts           Cart[]
  orders          Order[]

  @@map("users")
}

model Account {
  id                    String          @id @default(cuid())
  userId                String          @map("user_id")
  accountId             String          @map("account_id") // BetterAuth: The ID of the account as provided by the SSO or equal to userId for credential accounts
  providerId            String          @map("provider_id")
  provider              AccountProvider
  accessToken           String?         @map("access_token")
  refreshToken          String?         @map("refresh_token")
  accessTokenExpiresAt  DateTime?       @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime?       @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?         @map("id_token")
  password              String?
  isActive              Boolean         @default(true) @map("is_active")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime?       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model CustomerProfile {
  id              String      @id @default(cuid())
  userId          String      @unique @map("user_id")
  preferredMarket MarketCode? @map("preferred_market")
  phone           String?
  birthDate       DateTime?   @map("birth_date")
  document        String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime?   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model Address {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  market       MarketCode
  label        String?
  recipient    String?
  postalCode   String     @map("postal_code")
  addressLine1 String     @map("address_line_1")
  number       String?
  addressLine2 String?    @map("address_line_2")
  district     String?
  city         String
  state        String
  country      String
  isDefault    Boolean    @default(false) @map("is_default")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime?  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([market])
  @@index([userId, isDefault])
  @@map("address")
}

model UserConsent {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  termId     String   @map("term_id")
  acceptedAt DateTime @map("accepted_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  terms ConsentTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([userId, termId])
  @@index([userId])
  @@map("user_consent")
}

model ConsentTerm {
  id          String      @id @default(cuid())
  type        ConsentType
  version     String
  title       String
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime?   @updatedAt @map("updated_at")

  userConsents UserConsent[]

  @@unique([type, version])
  @@index([type])
  @@map("consent_terms")
}

model Market {
  id             String       @id @default(cuid())
  code           MarketCode   @unique
  label          String
  locale         String
  currency       CurrencyCode
  shippingAmount Int          @map("shipping_amount")
  taxRate        Decimal      @map("tax_rate") @db.Decimal(5, 4)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime?    @updatedAt @map("updated_at")

  offers     Offer[]
  orderBumps OrderBump[]
  carts      Cart[]

  @@map("markets")
}

model Product {
  id               String        @id @default(cuid())
  sku              String        @unique
  slug             String        @unique
  name             String
  shortDescription String        @map("short_description")
  description      String?
  imageUrl         String?       @map("image_url")
  pillsPerPack     Int?          @map("pills_per_pack")
  status           ProductStatus @default(DRAFT)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime?     @updatedAt @map("updated_at")

  offerItems OfferItem[]
  orderBumps OrderBump[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model Offer {
  id              String      @id @default(cuid())
  slug            String
  marketCode      MarketCode  @map("market_code")
  name            String
  description     String
  unitAmount      Int         @map("unit_amount") // Preço unitário
  discountPercent Int         @default(0) @map("discount_percent")
  isHighlighted   Boolean     @default(false) @map("is_highlighted")
  status          OfferStatus @default(DRAFT)
  sortOrder       Int         @default(0) @map("sort_order")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime?   @updatedAt @map("updated_at")

  market    Market      @relation(fields: [marketCode], references: [code])
  items     OfferItem[]
  cartItems CartItem[]

  @@unique([marketCode, slug])
  @@index([marketCode])
  @@index([status])
  @@map("offers")
}

model OfferItem {
  id        String   @id @default(cuid())
  offerId   String   @map("offer_id")
  productId String   @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([offerId])
  @@index([productId])
  @@map("offer_items")
}

model OrderBump {
  id          String     @id @default(cuid())
  productId   String     @map("product_id")
  marketCode  MarketCode @map("market_code")
  name        String
  description String
  unitAmount  Int        @map("unit_amount")
  quantity    Int        @default(1)
  isActive    Boolean    @default(true) @map("is_active")
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime?  @updatedAt @map("updated_at")

  product   Product    @relation(fields: [productId], references: [id])
  market    Market     @relation(fields: [marketCode], references: [code])
  cartItems CartItem[]

  @@index([marketCode])
  @@index([productId])
  @@map("order_bumps")
}

model Cart {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  marketCode MarketCode @map("market_code")
  status     CartStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime?  @updatedAt @map("updated_at")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Market     @relation(fields: [marketCode], references: [code])
  items  CartItem[]
  orders Order[]

  @@index([userId])
  @@index([status])
  @@map("carts")
}

model CartItem {
  id          String       @id @default(cuid())
  cartId      String       @map("cart_id")
  productId   String?      @map("product_id")
  offerId     String?      @map("offer_id")
  orderBumpId String?      @map("order_bump_id")
  type        CartItemType
  quantity    Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime?    @updatedAt @map("updated_at")

  cart      Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offer     Offer?     @relation(fields: [offerId], references: [id])
  orderBump OrderBump? @relation(fields: [orderBumpId], references: [id])
  product   Product?   @relation(fields: [productId], references: [id])

  @@index([cartId])
  @@index([offerId])
  @@index([orderBumpId])
  @@map("cart_items")
}

model Order {
  id              String       @id @default(cuid())
  userId          String       @map("user_id")
  cartId          String?      @map("cart_id")
  marketCode      MarketCode   @map("market_code")
  currency        CurrencyCode
  status          OrderStatus  @default(PENDING_PAYMENT)
  itemsAmount     Int          @map("items_amount")
  orderBumpAmount Int          @default(0) @map("order_bump_amount")
  subtotalAmount  Int          @map("subtotal_amount")
  discountAmount  Int          @default(0) @map("discount_amount")
  taxAmount       Int          @default(0) @map("tax_amount")
  shippingAmount  Int          @default(0) @map("shipping_amount")
  totalAmount     Int          @map("total_amount")
  expiresAt       DateTime?    @map("expires_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime?    @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id])
  cart     Cart?       @relation(fields: [cartId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([cartId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String        @id @default(cuid())
  orderId     String        @map("order_id")
  productId   String?       @map("product_id")
  type        OrderItemType
  name        String
  sku         String
  quantity    Int
  unitAmount  Int           @map("unit_amount")
  totalAmount Int           @map("total_amount")
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                    String          @id @default(cuid())
  orderId               String          @map("order_id")
  provider              PaymentProvider
  status                PaymentStatus   @default(PENDING)
  amount                Int
  currency              CurrencyCode
  providerSessionId     String?         @unique @map("provider_session_id")
  providerPaymentIntent String?         @map("provider_payment_intent")
  providerCheckoutUrl   String?         @map("provider_checkout_url")
  rawPayload            Json?           @map("raw_payload")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime?       @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model StripeWebhookEvent {
  id               String                   @id @default(cuid())
  providerEventId  String                   @unique @map("provider_event_id")
  providerObjectId String?                  @map("provider_object_id")
  eventType        String                   @map("event_type")
  status           StripeWebhookEventStatus @default(PROCESSING)
  errorMessage     String?                  @map("error_message")
  processedAt      DateTime?                @map("processed_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime?                @updatedAt @map("updated_at")

  @@index([eventType])
  @@index([providerObjectId])
  @@map("stripe_webhook_events")
}
